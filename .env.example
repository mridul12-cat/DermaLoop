# Public sample + fixed synthetic verification need NO provider credentials.
# Never add provider secrets to the judge deployment.
YOUCAM_LIVE_ENABLED=false
# Private operator adapter variables are documented in docs/YOUCAM_INTEGRATION.md.
# YOUCAM_API_KEY=
# TASK_TOKEN_SECRET=
# REVIEWER_ACCESS_CODE=
# YOUCAM_BASE_URL=https://yce-api-01.makeupar.com
# YOUCAM_UPLOAD_HOSTS=yce-us.s3-accelerate.amazonaws.com

# Optional development-only companion. See LOCAL_LIVE_SETUP.md first.
# Use YOUR OWN official API key; never copy another project's private files.
# DERMALOOP_LOCAL_LIVE=false
# To activate locally: set both DERMALOOP_LOCAL_LIVE and YOUCAM_LIVE_ENABLED=true,
# then npm run local:live -- --allow-local-live. Neither flag enables public routes.
# The local companion needs no TASK_TOKEN_SECRET or REVIEWER_ACCESS_CODE.
